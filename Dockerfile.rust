FROM rust:1.89-bookworm AS build
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY frontend ./frontend
COPY migrations ./migrations
COPY site ./site
RUN cargo build --release -p srep-server -p srep-cli

FROM debian:bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
ENV SREP_DATABASE_URL=sqlite:/data/srep.db
ENV SREP_MEDIA_DIR=/data/media
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/srep-server /usr/local/bin/srep-server
COPY --from=build /app/target/release/srep /usr/local/bin/srep
COPY migrations /app/migrations
RUN mkdir -p /data
VOLUME /data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["curl", "-fsS", "http://127.0.0.1:3000/healthz"]
ENTRYPOINT ["/usr/local/bin/srep-server"]
