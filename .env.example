# Default sqlite:./data/srep.db. Postgres example: postgres://srep:change-me@localhost:5432/srep
SREP_DATABASE_URL=sqlite:./data/srep.db

# Default info. One of fatal, error, warn, info, debug, trace, silent.
SREP_LOG_LEVEL=info

# Optional. Default is <cwd>/drizzle/<dialect>.
# SREP_MIGRATIONS_DIR=

# Default true. Use true or false.
SREP_MIGRATE_ON_START=true
