# Default sqlite:./data/srep.db. Postgres example: postgres://srep:change-me@localhost:5432/srep
SREP_DATABASE_URL=sqlite:./data/srep.db

# Default info. One of fatal, error, warn, info, debug, trace, silent.
SREP_LOG_LEVEL=info

# Optional. Default is <cwd>/drizzle/<dialect>.
# SREP_MIGRATIONS_DIR=

# Default true. Use true or false.
SREP_MIGRATE_ON_START=true

# Default http://localhost:3000. The public origin. Use https, or http on localhost.
SREP_ORIGIN=http://localhost:3000

# Default is the host of SREP_ORIGIN. The host, or a parent domain of it.
# SREP_RP_ID=

# Default srep. The name that the authenticator shows.
# SREP_RP_NAME=srep
